# Copy to .env and fill in. Never commit .env.

# How the agents run: live | fallback | demo  (fallback recommended for judging)
NEUR_MODE=fallback

# Seconds before an agent falls back (Quill gets longer for web search)
NEUR_AGENT_TIMEOUT=25
NEUR_LEGAL_TIMEOUT=45

# Seconds each saved answer "takes" in demo mode, so the animation still plays
NEUR_DEMO_DELAY=1.5

# Amazon Bedrock (use an IAM role in AWS; no access keys in this file)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=your-claude-model-id-here
