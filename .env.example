# Copy to .env and fill in. Never commit .env.

# How the agents run: live | fallback | demo  (fallback recommended for judging)
NEUR_MODE=fallback

# Seconds before an agent falls back (Quill gets longer for web search)
NEUR_AGENT_TIMEOUT=25
NEUR_LEGAL_TIMEOUT=45

# Seconds each saved answer "takes" in demo mode, so the animation still plays
NEUR_DEMO_DELAY=1.5

# Amazon Bedrock (use an IAM role in AWS; no access keys in this file)
# Region must be one where your Claude model is enabled (the project Region is us-east-2).
AWS_REGION=us-east-2
# BEDROCK_MODEL_ID must be an INFERENCE PROFILE ID, not a bare model ID. Newer
# Claude models reject on-demand invocation by raw model id ("Invocation ... with
# on-demand throughput isn't supported"); the profile id (prefixed us. or global.) works.
# Example (Claude Haiku 4.5 in us-east-2): us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
